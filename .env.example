# Copy to .env.local and restart the local server.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-oss-20b
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo

# PostHog browser analytics
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
